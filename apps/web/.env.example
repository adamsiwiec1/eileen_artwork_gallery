# Leave this unset locally. Requests then stay relative and Vite proxies /api to
# the Express server, which is also what makes ngrok work without CORS.
#
# Set it only for production builds, to the Render API origin, with no trailing
# slash. In CI this comes from the VITE_API_URL repository variable.
# VITE_API_URL=https://eileen-api.onrender.com
