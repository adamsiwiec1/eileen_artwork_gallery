# ---------------------------------------------------------------------------
# Everything works with this file absent. Defaults are free and need no keys:
#   images -> Pollinations (no key, no account)
#   chat   -> heuristic (no LLM, instructions concatenated)
# ---------------------------------------------------------------------------

# RECOMMENDED FREE UPGRADE — one key covers both images and chat.
# Free tier, no credit card: https://aistudio.google.com/apikey
# Enables true conversational image editing rather than re-rendering.
# GEMINI_API_KEY=

# Free chat-only alternative (30 req/min, 1000/day): https://console.groq.com/keys
# GROQ_API_KEY=

# Paid. Best quality, but gpt-image-1 bills per image and has no free tier.
# OPENAI_API_KEY=

# Force a provider instead of letting the keys above decide.
#   images: pollinations | gemini | openai | mock
#   chat:   heuristic | gemini | groq | openai
# IMAGE_PROVIDER=pollinations
# CHAT_PROVIDER=heuristic

# Model overrides.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile

PORT=4000
WEB_ORIGIN=http://localhost:5173
POLLINATIONS_REFERRER=eileen-gallery

# Payment processor undecided. Leave unset for the simulated checkout.
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# SQUARE_ACCESS_TOKEN=
