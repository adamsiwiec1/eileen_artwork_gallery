# Copy to .env.local. Empty values keep the in-memory store, mock shipping
# rates, heuristic chat, and Pollinations images.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowlist. Local fallback: eileen@example.com
ADMIN_EMAILS=eileen@example.com
ADMIN_DEV_PASS=eileen-studio

STUDIO_NAME=Eileen Atelier
STUDIO_STREET1=179 N Harbor Dr
STUDIO_CITY=Redondo Beach
STUDIO_STATE=CA
STUDIO_ZIP=90277
STUDIO_COUNTRY=US

IMAGE_PROVIDER=pollinations
CHAT_PROVIDER=heuristic
SPACE_ID=
EILEEN_STEPS=8
EILEEN_GUIDANCE=4.0
POLLINATIONS_REFERRER=eileen-gallery

# RunPod serverless LoRA (set both names after you create the endpoint).
# RUNPOD_API_KEY
# RUNPOD_ENDPOINT_ID

# Optional providers — set the same names the Express app used
# (EasyPost test token, Resend, Gemini, Groq, OpenAI, HF token).
